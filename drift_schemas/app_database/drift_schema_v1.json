          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"latitude\" REAL NULL, \"longitude\" REAL NULL, \"place_name\" TEXT NULL, \"place_name_ar\" TEXT NULL, \"region_name\" TEXT NULL, \"region_name_ar\" TEXT NULL, \"country_code\" TEXT NULL, \"time_zone\" TEXT NULL, \"location_mode\" TEXT NULL, \"method\" TEXT NULL, \"asr_method\" TEXT NULL, \"hijri_adjust\" INTEGER NOT NULL DEFAULT 0 CHECK(\"hijri_adjust\" BETWEEN -2 AND 2), \"digits\" TEXT NOT NULL DEFAULT 'eastern', \"theme\" TEXT NOT NULL DEFAULT 'qiyamEmerald', \"theme_mode\" TEXT NOT NULL DEFAULT 'followSky', \"reduce_motion\" INTEGER NOT NULL DEFAULT 0 CHECK (\"reduce_motion\" IN (0, 1)), \"haptics\" INTEGER NOT NULL DEFAULT 1 CHECK (\"haptics\" IN (0, 1)), \"ui_sounds\" INTEGER NOT NULL DEFAULT 0 CHECK (\"ui_sounds\" IN (0, 1)), \"store_reset_pending\" INTEGER NOT NULL DEFAULT 0 CHECK (\"store_reset_pending\" IN (0, 1)), PRIMARY KEY (\"id\"));"
