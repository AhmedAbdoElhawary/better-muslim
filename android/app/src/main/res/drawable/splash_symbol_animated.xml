<?xml version="1.0" encoding="utf-8"?>
<!-- android 12+ draws a still splash icon into a small bitmap and stretches it, an animated one is
     drawn as vector every frame. the fade is MOTION 01's logo fade in -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_symbol">
    <target android:name="symbol">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:interpolator="@android:interpolator/decelerate_cubic"
                android:propertyName="alpha"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
