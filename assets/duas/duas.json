{
  "categories": [
    {
      "id": "leaving-home",
      "name": {
        "en": "Leaving the home",
        "ar": "مغادرة المنزل"
      },
      "chip": "home",
      "duas": [
        {
          "id": "d001",
          "arabic": "بِسْمِ اللَّهِ، تَوَكَّلْتُ عَلَى اللَّهِ، وَلَاَ حَوْلَ وَلَا قُوَّةَ إِلاَّ بِاللَّهِ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Abu Dawud 4/325, at-Tirmidhi 5/490",
            "ar": "أبو داود ٤/٣٢٥، الترمذي ٥/٤٩٠"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d002",
          "arabic": "اللَّهُمَّ إِنِّي أَعُوذُ بِكَ أَنْ أَضِلَّ، أَوْ أُضَلَّ، أَوْ أَزِلَّ، أَوْ أُزَلَّ، أَوْ أَظْلِمَ، أَوْ أُظْلَمَ، أَوْ أَجْهَلَ، أَوْ يُجْهَلَ عَلَيَّ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "The Sunan",
            "ar": "أهل السنن"
          },
          "grading": null,
          "audio": null
        }
      ]
    },
    {
      "id": "waking-up",
      "name": {
        "en": "Waking up",
        "ar": "الاستيقاظ"
      },
      "chip": "morningEvening",
      "duas": [
        {
          "id": "d003",
          "arabic": "الْحَمْدُ للَّهِ الَّذِي أَحْيَانَا بَعْدَ مَا أَمَاتَنَا، وَإِلَيْهِ النُّشُورُ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Al-Bukhari 11/113, Muslim 4/2083",
            "ar": "البخاري ١١/١١٣، مسلم ٤/٢٠٨٣"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d004",
          "arabic": "لاَ إِلَهَ إِلاَّ اللَّهُ وَحْدَهُ لاَ شَريكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ، وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ، سُبْحَانَ اللَّهِ، وَالْحَمْدُ للَّهِ، وَلاَ إِلَهَ إِلاَّ اللَّهُ، وَاللَّهُ أَكبَرُ، وَلاَ حَوْلَ وَلاَ قُوَّةَ إِلاَّ بِاللَّهِ الْعَلِيِّ الْعَظِيمِ، رَبِّ اغْفرْ لِي",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Al-Bukhari 3/144, Ibn Majah",
            "ar": "البخاري ٣/١٤٤، ابن ماجه"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d005",
          "arabic": "الْحَمْدُ لِلَّهِ الَّذِي عَافَانِي فِي جَسَدِي، وَرَدَّ عَلَيَّ رُوحِي، وَأَذِنَ لي بِذِكْرِهِ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "At-Tirmidhi 5/473",
            "ar": "الترمذي ٥/٤٧٣"
          },
          "grading": null,
          "audio": null
        }
      ]
    },
    {
      "id": "before-sleeping",
      "name": {
        "en": "Before sleeping",
        "ar": "قبل النوم"
      },
      "chip": "sleep",
      "duas": [
        {
          "id": "d006",
          "arabic": "بِاسْمِكَ رَبِّي وَضَعْتُ جَنْبِي، وَبِكَ أَرْفَعُهُ، فَإِن أَمْسَكْتَ نَفْسِي فارْحَمْهَا، وَإِنْ أَرْسَلْتَهَا فَاحْفَظْهَا، بِمَا تَحْفَظُ بِهِ عِبَادَكَ الصَّالِحِينَ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Al-Bukhari 11/126, Muslim 4/2084",
            "ar": "البخاري ١١/١٢٦، مسلم ٤/٢٠٨٤"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d007",
          "arabic": "اللَّهُمَّ إِنَّكَ خَلَقْتَ نَفْسِي وَأَنْتَ تَوَفَّاهَا، لَكَ مَمَاتُهَا وَمَحْياهَا، إِنْ أَحْيَيْتَهَا فَاحْفَظْهَا، وَإِنْ أَمَتَّهَا فَاغْفِرْ لَهَا. اللَّهُمَّ إِنِّي أَسْأَلُكَ العَافِيَةَ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Muslim 4/2083, Ahmad 2/79",
            "ar": "مسلم ٤/٢٠٨٣، أحمد ٢/٧٩"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d008",
          "arabic": "اللَّهُمَّ قِنِي عَذَابَكَ يَوْمَ تَبْعَثُ عِبَادَكَ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Abu Dawud 4/311",
            "ar": "أبو داود ٤/٣١١"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d009",
          "arabic": "بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Al-Bukhari 11/113, Muslim 4/2083",
            "ar": "البخاري ١١/١١٣، مسلم ٤/٢٠٨٣"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d010",
          "arabic": "سُبْحَانَ اللَّهِ (ثلاثاً وثلاثين) وَالْحَمْدُ لِلَّهِ (ثلاثاً وثلاثين) وَاللَّهُ أَكْبَرُ (أربعاً وثلاثينَ)",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Al-Bukhari 7/71, Muslim 4/2091",
            "ar": "البخاري ٧/٧١، مسلم ٤/٢٠٩١"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d011",
          "arabic": "اللَّهُمَّ رَبَّ السَّمَوَاتِ السَّبْعِ وَرَبَّ الأَرْضِ، وَرَبَّ الْعَرْشِ الْعَظِيمِ، رَبَّنَا وَرَبَّ كُلِّ شَيْءٍ، فَالِقَ الْحَبِّ وَالنَّوَى، وَمُنْزِلَ التَّوْرَاةِ وَالْإِنْجِيلِ، وَالْفُرْقَانِ، أَعُوذُ بِكَ مِنْ شَرِّ كُلِّ شَيْءٍ أَنْتَ آخِذٌ بِنَاصِيَتِهِ. اللَّهُمَّ أَنْتَ الأَوَّلُ فَلَيْسَ قَبْلَكَ شَيْءٌ، وَأَنْتَ الآخِرُ فَلَيسَ بَعْدَكَ شَيْءٌ، وَأَنْتَ الظَّاهِرُ فَلَيْسَ فَوْقَكَ شَيْءٌ، وَأَنْتَ الْبَاطِنُ فَلَيْسَ دُونَكَ شَيْءٌ، اقْضِ عَنَّا الدَّيْنَ وَأَغْنِنَا مِنَ الْفَقْرِ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Muslim 4/2084",
            "ar": "مسلم ٤/٢٠٨٤"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d012",
          "arabic": "الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنَا وَسَقَانَا، وَكَفَانَا، وَآوَانَا، فَكَمْ مِمَّنْ لاَ كَافِيَ لَهُ وَلاَ مُؤْوِيَ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Muslim 4/2085",
            "ar": "مسلم ٤/٢٠٨٥"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d013",
          "arabic": "اللَّهُمَّ عَالِمَ الغَيْبِ وَالشَّهَادَةِ فَاطِرَ السَّمَوَاتِ وَالْأَرْضِ، رَبَّ كُلِّ شَيْءٍ وَمَلِيكَهُ، أَشْهَدُ أَنْ لاَ إِلَهَ إِلاَّ أَنْتَ، أَعُوذُ بِكَ مِنْ شَرِّ نَفْسِي، وَمِنْ شَرِّ الشَّيْطانِ وَشِرْكِهِ، وَأَنْ أَقْتَرِفَ عَلَى نَفْسِي سُوءاً، أَوْ أَجُرَّهُ إِلَى مُسْلِمٍ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Abu Dawud 4/317",
            "ar": "أبو داود ٤/٣١٧"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d014",
          "arabic": "اللَّهُمَّ أَسْلَمْتُ نَفْسِي إِلَيْكَ، وَفَوَّضْتُ أَمْرِي إِلَيْكَ، وَوَجَّهْتُ وَجْهِي إِلَيْكَ، وَأَلْجَأْتُ ظَهْرِي إِلَيْكَ، رَغْبَةً وَرَهْبَةً إِلَيْكَ، لاَ مَلْجَأَ وَلاَ مَنْجَا مِنْكَ إِلاَّ إِلَيْكَ، آمَنْتُ بِكِتَابِكَ الَّذِي أَنْزَلْتَ، وَبِنَبِيِّكَ الَّذِي أَرْسَلْتَ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Al-Bukhari 11/113, Muslim 4/2081",
            "ar": "البخاري ١١/١١٣، مسلم ٤/٢٠٨١"
          },
          "grading": null,
          "audio": null
        }
      ]
    },
    {
      "id": "mosque",
      "name": {
        "en": "Entering and leaving the mosque",
        "ar": "دخول المسجد والخروج منه"
      },
      "chip": "home",
      "duas": [
        {
          "id": "d015",
          "arabic": "أَعُوذُ بِاللَّهِ العَظِيمِ، وَبِوَجْهِهِ الْكَرِيمِ، وَسُلْطَانِهِ الْقَدِيمِ، مِنَ الشَّيْطَانِ الرَّجِيمِ، بِسْمِ اللَّهِ، وَالصَّلَاةُ وَالسَّلَامُ عَلَى رَسُولِ اللَّهِ، اللَّهُمَّ افْتَحْ لِي أَبْوَابَ رَحْمَتِكَ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Abu Dawud, Ibn as-Sunni 88, Muslim 1/494",
            "ar": "أبو داود، ابن السني ٨٨، مسلم ١/٤٩٤"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d016",
          "arabic": "بِسْمِ اللَّهِ وَالصّلَاةُ وَالسَّلَامُ عَلَى رَسُولِ اللَّهِ، اللَّهُمَّ إِنِّي أَسْأَلُكَ مِنْ فَضْلِك، اللَّهُمَّ اعْصِمْنِي مِنَ الشَّيْطَانِ الرَّجِيمِ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Muslim 1/494, Ibn Majah",
            "ar": "مسلم ١/٤٩٤، ابن ماجه"
          },
          "grading": null,
          "audio": null
        }
      ]
    },
    {
      "id": "eating",
      "name": {
        "en": "Before and after eating",
        "ar": "قبل الطعام وبعده"
      },
      "chip": "home",
      "duas": [
        {
          "id": "d017",
          "arabic": "إِذَا أَكَلَ أَحَدُكُمْ طَعَاماً فَلْيَقُلْ بِسْمِ اللَّهِ، فَإِنْ نَسِيَ فِي أَوَّلِهِ فَلْيَقُلْ بسمِ اللَّهِ فِي أَوَّلِهِ وَآخِرِهِ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Abu Dawud 3/347, at-Tirmidhi 4/288",
            "ar": "أبو داود ٣/٣٤٧، الترمذي ٤/٢٨٨"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d018",
          "arabic": "مَنْ أَطْعَمَهُ اللَّهُ الطَّعَامَ فَلْيَقُلْ: اللَّهُمَّ بَارِكْ لَنَا فِيهِ وَأَطْعِمْنَا خَيْراً مِنْهُ، وَمَنْ سَقَاهُ اللَّهُ لَبَناً فَلْيَقُلْ اللَّهُمَّ بَارِكْ لَنَا فِيهِ وَزِدْنَا مِنْهُ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "At-Tirmidhi 5/506",
            "ar": "الترمذي ٥/٥٠٦"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d019",
          "arabic": "الْحَمْدُ لِلَّهِ الَّذِي أَطْعَمَنِي هَذَا، وَرَزَقَنِيهِ، مِنْ غَيْرِ حَوْلٍ مِنِّي وَلاَ قُوَّةٍ",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Abu Dawud, at-Tirmidhi, Ibn Majah",
            "ar": "أبو داود، الترمذي، ابن ماجه"
          },
          "grading": null,
          "audio": null
        },
        {
          "id": "d020",
          "arabic": "الْحَمْدُ لِلَّهِ حَمْداً كَثِيراً طَيِّباً مُبَارَكاً فِيهِ، غَيْرَ مَكْفِيٍّ وَلاَ مُوَدَّعٍ، وَلاَ مُسْتَغْنَىً عَنْهُ رَبَّنَا",
          "transliteration": "",
          "translation": "",
          "source": {
            "en": "Al-Bukhari 6/214, at-Tirmidhi 5/507",
            "ar": "البخاري ٦/٢١٤، الترمذي ٥/٥٠٧"
          },
          "grading": null,
          "audio": null
        }
      ]
