#!/usr/bin/env bash
#
# the rulesets refuse these on the server, this refuses them before the push leaves the mac.
# turn it on once per clone: git config core.hooksPath .githooks

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/develop|refs/heads/staging|refs/heads/production)
      echo "pre-push: '${remote_ref#refs/heads/}' only changes through a merged PR. Push a feature branch and open one." >&2
      exit 1
      ;;
    refs/tags/v*)
      echo "pre-push: version tags are made by release-on-merge.yml after a PR merges, not by hand." >&2
      exit 1
      ;;
  esac
done

exit 0
