<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TODO(ahmed): turn on Time Sensitive Notifications for the app ids in the Apple developer account, without it iOS delivers adhans as normal notifications. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- TODO(ahmed): create group.com.elhawary.bettermuslim, .dev and .staging in the Apple developer account and add them to the app ids, else the widgets read nothing. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(APP_GROUP)</string>
	</array>
</dict>
</plist>
